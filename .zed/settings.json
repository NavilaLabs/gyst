{
  "inlay_hints": {
    "enabled": true
  },
  // "show_edit_predictions": false,
  "file_scan_exclusions": ["**/Cargo.lock"],
  "lsp": {
    "rust-analyzer": {
      "initialization_options": {
        "linkedProjects": [
          "./Cargo.toml",
          "zeitrak-presentation/gui/Cargo.toml"
        ],
        "check": {
          "command": "clippy"
        }
      }
    },
    "tailwindcss-language-server": {
      "settings": {
        "includeLanguages": {
          "rust": "html",
          "*.rs": "html"
        }
      }
    }
  }
}
